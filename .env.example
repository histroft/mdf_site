# WEB_NST -> RENDER_NEW (same machine)
RENDER_API_URL=http://127.0.0.1:5000
RENDER_API_TOKEN=change-me
RENDER_CONNECT_TIMEOUT=10
RENDER_TIMEOUT=3600
RENDER_DOWNLOAD_TIMEOUT=120
RENDER_MAX_IMAGE_BYTES=26214400

# Local storage for statuses and PNG copies returned to the browser.
RESULT_3D_DIR=/path/to/WEB_NST/temp/3d-results

# Use the same RENDER_NEW asset catalogue that serves the HTTP API.
MODULE_3D_DIR=/path/to/RENDER_NEW
